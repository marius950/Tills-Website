---
// Google-Bewertungen als Vertrauenssignal. Daten kuratiert in src/data/bewertungen.ts.
// Bewusst ohne aggregateRating-Schema: Google wertet Bewertungen, die eine Praxis selbst
// einbindet („self-serving"), nicht für Rich Results und kann sie als Spam einstufen.
import { googleBewertungen } from '../data/bewertungen';

interface Props {
  variante?: 'badge' | 'zitate';
}
const { variante = 'badge' } = Astro.props;

const { schnitt, anzahl, stand, profilUrl, zitate } = googleBewertungen;
const schnittText = schnitt.toLocaleString('de-DE', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const volleSterne = Math.round(schnitt);
const sterne = '★'.repeat(volleSterne) + '☆'.repeat(5 - volleSterne);
const bewertungLabel = `Google-Bewertung ${schnittText} von 5 Sternen bei ${anzahl} Bewertungen`;
---

{
  variante === 'badge' ? (
    <a
      class="gb-badge"
      href={profilUrl}
      target="_blank"
      rel="noopener"
      aria-label={`${bewertungLabel} – Profil bei Google öffnen`}
    >
      <span class="gb-sterne" aria-hidden="true">
        {sterne}
      </span>
      <span>
        <strong>{schnittText}</strong> bei Google · {anzahl} Bewertungen
      </span>
    </a>
  ) : (
    <div class="gb-zitate">
      <div class="section-head">
        <span class="eyebrow">Google-Bewertungen</span>
        <h2>Das sagen Patient:innen</h2>
      </div>
      <div class="grid grid--3">
        {zitate.map((zitat) => (
          <figure class="card gb-zitat">
            <blockquote>„{zitat.text}“</blockquote>
            <figcaption>
              {zitat.name} · {zitat.datum}
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="center mt-2">
        <a href={profilUrl} target="_blank" rel="noopener">
          Alle Bewertungen bei Google lesen
        </a>
      </p>
    </div>
  )
}

<style>
  .gb-sterne {
    color: #d9a441;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .gb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .gb-badge:hover span:last-child {
    text-decoration: underline;
  }

  .gb-zitat {
    margin: 0;
  }

  .gb-zitat blockquote {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .gb-zitat figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
