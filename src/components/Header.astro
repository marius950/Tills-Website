---
import fs from 'node:fs';

// Praxislogo: sobald public/images/praxis-logo.png (oder .svg) vorliegt,
// erscheint es automatisch oben links statt des Text-Logos.
const logoDatei = ['public/images/praxis-logo.svg', 'public/images/praxis-logo.png'].find((p) =>
  fs.existsSync(p)
);
const logoUrl = logoDatei ? logoDatei.replace('public', '') : null;

const nav = [
  { href: '/', label: 'Start' },
  { href: '/ueber-mich/', label: 'Über mich' },
  { href: '/was-ist-osteopathie/', label: 'Was ist Osteopathie?' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/wissen/', label: 'Wissen' },
  { href: '/kontakt/', label: 'Kontakt' },
];

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="logo">
      {logoUrl && <img src={logoUrl} class="logo-mark" alt="" width="512" height="512" />}
      <span class="logo-text">Till Schneider<span class="logo-sub">Osteopathie</span></span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-ls-mobile">
          <a href="/leichte-sprache/" class="ls-button">Leichte Sprache</a>
        </li>
        <li class="nav-cta-mobile">
          <a href="/terminbuchung/" class="btn btn--primary">Termin buchen</a>
        </li>
      </ul>
    </nav>

    <a href="/leichte-sprache/" class="ls-button header-ls">Leichte Sprache</a>
    <a href="/terminbuchung/" class="btn btn--primary header-cta">Termin buchen</a>

    <button class="burger" id="burger" aria-expanded="false" aria-controls="main-nav" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Mobiler Sticky-CTA am unteren Bildschirmrand -->
<a href="/terminbuchung/" class="btn btn--primary sticky-cta">Termin buchen</a>

<script>
  const burger = document.getElementById('burger');
  const navEl = document.getElementById('main-nav');
  burger?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(!!open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 247, 242, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(28, 27, 26, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .logo-mark {
    height: 46px;
    width: 46px;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-head);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  .logo-sub {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .main-nav ul {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
  }

  .main-nav a:not(.btn):not(.ls-button) {
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .main-nav a:not(.btn):not(.ls-button):hover,
  .main-nav a[aria-current='page']:not(.btn):not(.ls-button) {
    border-bottom-color: var(--primary);
  }

  .nav-cta-mobile { display: none; }
  .nav-ls-mobile { display: none; }

  /* Leichte Sprache als Pill-Button, wie der Link im Footer */
  .ls-button {
    display: inline-block;
    border: 1px solid rgba(28, 27, 26, 0.35);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .ls-button:hover {
    background: var(--bg-accent);
    border-color: var(--secondary);
  }

  .header-ls {
    margin-left: auto;
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }

  .burger span {
    width: 24px;
    height: 2px;
    background: var(--text);
  }

  .sticky-cta { display: none; }

  @media (max-width: 1080px) {
    .header-cta { display: none; }
    .header-ls { display: none; }
    .burger { display: flex; }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid rgba(28, 27, 26, 0.1);
      padding: 1rem 1.25rem 1.5rem;
    }

    .main-nav.open { display: block; }

    .main-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }

    .main-nav a:not(.btn):not(.ls-button) {
      display: block;
      padding: 0.6rem 0;
      font-size: 1.05rem;
    }

    .nav-ls-mobile {
      display: block;
      margin-top: 1rem;
    }

    .nav-cta-mobile {
      display: block;
      margin-top: 0.75rem;
    }

    .nav-cta-mobile .btn { display: block; }

    .sticky-cta {
      display: block;
      position: fixed;
      bottom: 0.75rem;
      left: 1rem;
      right: 1rem;
      z-index: 40;
      box-shadow: 0 4px 16px rgba(28, 27, 26, 0.25);
    }

    /* Platz für den Sticky-Button am Seitenende */
    :global(body) { padding-bottom: 4.5rem; }
  }
</style>
