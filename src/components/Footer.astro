---
import { praxis } from '../config';
import Ph from './Ph.astro';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-logo">Till Schneider<br /><span>Osteopathie · Physiotherapeut · Heilpraktiker</span></p>
      <p>
        {praxis.name}<br />
        <Ph value={praxis.strasse} /><br />
        <Ph value={praxis.plzOrt} />
      </p>
    </div>

    <div>
      <p class="footer-head">Kontakt</p>
      <p>
        Telefon: <Ph value={praxis.telefon} /><br />
        E-Mail: <Ph value={praxis.email} />
      </p>
      <p class="footer-head">Behandlungszeiten</p>
      <p><Ph value={praxis.behandlungszeiten} /><br />Termine nach Vereinbarung.</p>
    </div>

    <div>
      <p class="footer-head">Termin</p>
      <p>Buch dir deinen Termin bequem online – rund um die Uhr.</p>
      <a href={praxis.doctolib} target="_blank" rel="noopener" class="btn btn--primary">Termin buchen</a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {new Date().getFullYear()} {praxis.name}</p>
    <nav aria-label="Rechtliches">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: #d9d4cb;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    font-size: 0.95rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .footer-logo {
    font-family: var(--font-head);
    font-size: 1.3rem;
    color: #f5f2ec;
    line-height: 1.3;
  }

  .footer-logo span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9b8a4;
  }

  .footer-head {
    font-weight: 600;
    color: #f5f2ec;
    margin-bottom: 0.35rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    border-top: 1px solid rgba(245, 242, 236, 0.15);
    padding-block: 1.25rem;
    font-size: 0.85rem;
  }

  .footer-bottom p { margin: 0; }

  .footer-bottom a {
    color: #d9d4cb;
    margin-left: 1rem;
  }

  .footer-bottom a:first-child { margin-left: 0; }
</style>
