---
import { praxis, hamburg, moelln } from '../config';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-logo">Till Schneider<br /><span>Osteopathie · Physiotherapeut · Heilpraktiker</span></p>
      <p class="footer-head"><a href={hamburg.seite}>Standort Hamburg</a></p>
      <p>
        {hamburg.adresse[0]}<br />
        {hamburg.adresse[1]}<br />
        {hamburg.adresse[2]}<br />
        Telefon: <a href={hamburg.telefonLink}>{hamburg.telefon}</a>
      </p>
      <p class="footer-head"><a href={moelln.seite}>Standort Mölln</a></p>
      <p>
        {moelln.adresse[0]}<br />
        {moelln.adresse[1]}<br />
        Telefon: <a href={moelln.telefonLink}>{moelln.telefon}</a>
      </p>
    </div>

    <div>
      <p class="footer-head">Kontakt</p>
      <p>E-Mail: <a href={`mailto:${praxis.email}`}>{praxis.email}</a></p>
      <p class="footer-head">Behandlungszeiten</p>
      <p>
        Hamburg: {hamburg.zeiten}<br />
        Mölln: {moelln.zeiten}
      </p>
    </div>

    <div>
      <p class="footer-head">Termin</p>
      <p>
        Termine für Hamburg buchst du online über Doctolib.
        Termine für Mölln vereinbarst du telefonisch.
      </p>
      <a href="/terminbuchung/" class="btn btn--primary">Termin buchen</a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {new Date().getFullYear()} {praxis.name}</p>
    <nav aria-label="Rechtliches">
      <a href="/leichte-sprache/" class="ls-link">Leichte Sprache</a>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: #d9d4cb;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    font-size: 0.95rem;
  }

  .site-footer a {
    color: #d9d4cb;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .footer-logo {
    font-family: var(--font-head);
    font-size: 1.3rem;
    font-weight: 700;
    color: #f5f2ec;
    line-height: 1.3;
  }

  .footer-logo span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9b8a4;
  }

  .footer-head {
    font-weight: 600;
    color: #f5f2ec;
    margin-bottom: 0.35rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    border-top: 1px solid rgba(245, 242, 236, 0.15);
    padding-block: 1.25rem;
    font-size: 0.85rem;
  }

  .footer-bottom p { margin: 0; }

  .footer-bottom nav a {
    margin-left: 1rem;
  }

  .footer-bottom nav a:first-child { margin-left: 0; }

  /* Leichte-Sprache-Link als kleiner Button hervorgehoben */
  .ls-link {
    display: inline-block;
    border: 1px solid rgba(245, 242, 236, 0.4);
    border-radius: 999px;
    padding: 0.25rem 0.85rem;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .ls-link:hover {
    background: #f5f2ec;
    color: var(--dark);
  }
</style>
