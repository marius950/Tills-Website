---
// Dezenter CTA-Baustein nach inhaltlichen Abschnitten – verlinkt direkt zu Doctolib
import { praxis } from '../config';

interface Props {
  text?: string;
  button?: string;
}
const { text, button = 'Termin buchen' } = Astro.props;
---

<div class="cta-block">
  {text && <p>{text}</p>}
  <a href={praxis.doctolib} target="_blank" rel="noopener" class="btn btn--primary">{button}</a>
</div>

<style>
  .cta-block {
    margin-block: 2.5rem 0;
    text-align: center;
  }

  .cta-block p {
    font-family: var(--font-head);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
</style>
