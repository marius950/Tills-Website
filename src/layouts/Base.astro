---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { praxis } from '../config';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// LocalBusiness-Schema (Abschnitt 5.3 des Konzepts) – Platzhalter vor Livegang ersetzen
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: praxis.name,
  founder: praxis.inhaber,
  address: {
    '@type': 'PostalAddress',
    streetAddress: praxis.strasse,
    addressLocality: praxis.plzOrt,
    addressCountry: 'DE',
  },
  telephone: praxis.telefon,
  email: praxis.email,
  url: Astro.site?.toString(),
  priceRange: praxis.preis,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-Reveal: Abschnittsinhalte blenden sanft ein (Fade + Slide-up).
      // Grid-/Listen-Kinder erscheinen gestaffelt. Respektiert prefers-reduced-motion.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        const staggered = ['grid', 'steps', 'timeline', 'badges', 'themen'];
        document.querySelectorAll('main .section > .wrap').forEach((wrap) => {
          for (const child of wrap.children) {
            if (staggered.some((c) => child.classList.contains(c))) {
              let i = 0;
              for (const item of child.children) {
                item.classList.add('reveal');
                (item as HTMLElement).style.setProperty('--reveal-delay', `${Math.min(i * 90, 450)}ms`);
                i++;
              }
            } else {
              child.classList.add('reveal');
            }
          }
        });

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
