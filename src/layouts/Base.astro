---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { praxis, hamburg, moelln, mapsLink } from '../config';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-image.jpg', Astro.site).toString();

// Strukturierte Daten: ein eigenständiger LocalBusiness-Eintrag je Standort
// (stärkstes On-Page-Signal für lokale Suchen) plus Person-Eintrag für E-E-A-T.
const standortSchema = (s: typeof hamburg | typeof moelln, id: string, extras = {}) => ({
  '@type': ['MedicalBusiness', 'Physiotherapy'],
  '@id': `${siteUrl}/#${id}`,
  name: `${praxis.name} – ${s.name}`,
  founder: { '@id': `${siteUrl}/#till-schneider` },
  url: new URL(s.seite, Astro.site).toString(),
  email: praxis.email,
  telephone: s.telefon,
  priceRange: praxis.preis,
  medicalSpecialty: 'Osteopathic',
  currenciesAccepted: 'EUR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: s.strasse,
    postalCode: s.plz,
    addressLocality: s.ort,
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: s.geo.lat,
    longitude: s.geo.lon,
  },
  image: new URL(s.praxisbild, Astro.site).toString(),
  hasMap: mapsLink(s),
  ...extras,
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    standortSchema(hamburg, 'hamburg', {
      areaServed: ['Hamburg-Rotherbaum', 'Eimsbüttel', 'Harvestehude', 'Hamburg'],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Tuesday',
          opens: '07:30',
          closes: '13:30',
        },
      ],
      sameAs: [praxis.doctolib],
      potentialAction: {
        '@type': 'ReserveAction',
        target: praxis.doctolib,
        name: 'Termin in Hamburg über Doctolib buchen',
      },
    }),
    standortSchema(moelln, 'moelln', {
      areaServed: ['Mölln', 'Ratzeburg', 'Schwarzenbek', 'Lauenburg', 'Kreis Herzogtum Lauenburg'],
    }),
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#till-schneider`,
      name: praxis.inhaber,
      url: new URL('/ueber-mich/', Astro.site).toString(),
      image: new URL('/images/till-portrait.webp', Astro.site).toString(),
      jobTitle: ['Osteopath', 'Physiotherapeut', 'Heilpraktiker'],
      knowsAbout: [
        'Osteopathie',
        'Physiotherapie',
        'Sportphysiotherapie',
        'Manuelle Therapie',
        'Craniomandibuläre Dysfunktion',
      ],
      worksFor: [{ '@id': `${siteUrl}/#hamburg` }, { '@id': `${siteUrl}/#moelln` }],
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={praxis.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-Reveal: Abschnittsinhalte blenden sanft ein (Fade + Slide-up).
      // Grid-/Listen-Kinder erscheinen gestaffelt. Respektiert prefers-reduced-motion.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        const staggered = ['grid', 'steps', 'timeline', 'badges', 'themen'];
        document.querySelectorAll('main .section > .wrap').forEach((wrap) => {
          for (const child of wrap.children) {
            if (staggered.some((c) => child.classList.contains(c))) {
              let i = 0;
              for (const item of child.children) {
                item.classList.add('reveal');
                (item as HTMLElement).style.setProperty('--reveal-delay', `${Math.min(i * 90, 450)}ms`);
                i++;
              }
            } else {
              child.classList.add('reveal');
            }
          }
        });

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
