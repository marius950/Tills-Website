---
import Base from '../layouts/Base.astro';
import StandortKarten from '../components/StandortKarten.astro';
import Ph from '../components/Ph.astro';
import { praxis, moelln } from '../config';

const checkliste = [
  {
    titel: 'Vorhandene Befunde und Arztberichte',
    text: 'z. B. Röntgen-, MRT- oder CT-Befunde, OP-Berichte, Laborwerte, sofern vorhanden',
  },
  {
    titel: 'Eine aktuelle Medikamentenliste',
    text: 'falls du regelmäßig Medikamente einnimmst',
  },
  {
    titel: 'Ein großes Handtuch',
    text: 'für die Behandlungsliege',
  },
  {
    titel: 'Bequeme Kleidung',
    text: 'in der du dich gut bewegen kannst; für die Untersuchung ist es hilfreich, wenn du dich bis auf die Unterwäsche frei machen kannst. Das besprechen wir aber immer gemeinsam und in deinem Tempo.',
  },
];
---

<Base
  title="Termin buchen | Osteopathie Hamburg & Mölln – Till Schneider"
  description="Osteopathie-Termin bei Till Schneider buchen: in Hamburg online über Doctolib, in Mölln telefonisch. Plus: Was du zum ersten Termin mitbringen solltest & alle Infos zu Kosten."
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Terminbuchung</span>
        <h1>Wähle deinen Standort</h1>
        <p class="content">
          Termine für Hamburg buchst du online über Doctolib. Termine für Mölln vereinbarst du
          telefonisch.
        </p>
      </div>
      <StandortKarten variante="buchung" />

      <p class="mt-2 small content-center">
        Du hast vorab Fragen? Schreib an <Ph value={praxis.email} /> oder ruf für Mölln direkt
        unter <a href={moelln.telefonLink}>{moelln.telefon}</a> an.
      </p>
    </div>
  </section>

  <section class="section section--beige">
    <div class="wrap content-center">
      <h2>Was du zum ersten Termin mitbringen solltest</h2>
      <p class="mt-2">Damit wir die Zeit optimal nutzen können, bring bitte Folgendes mit:</p>
      <div class="grid grid--2">
        {checkliste.map((c) => (
          <div class="card">
            <h3>{c.titel}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-2">
        Du musst nichts weiter vorbereiten. Komm am besten ein paar Minuten früher, damit
        wir entspannt starten können.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap content-center">
      <h2>Termin absagen oder verschieben</h2>
      <p class="mt-2">
        Manchmal kommt etwas dazwischen, das ist kein Problem. Bitte sag deinen Termin
        <strong>spätestens 24 Stunden vorher</strong> ab, entweder direkt über Doctolib (Hamburg)
        oder telefonisch. So kann ich den Termin an andere Patient:innen vergeben. Bei
        kurzfristigen Absagen kann ein Ausfallhonorar anfallen.
      </p>
    </div>
  </section>

  <section class="section section--beige">
    <div class="wrap content-center">
      <h2>Kosten &amp; Erstattung</h2>

      <h3 class="mt-2">Preise</h3>
      <table class="preis-tabelle">
        <thead>
          <tr>
            <th>Leistung</th>
            <th>Dauer</th>
            <th>Preis</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Osteopathische Behandlung</td>
            <td>{praxis.dauer}</td>
            <td>{praxis.preis}</td>
          </tr>
        </tbody>
      </table>
      <p>
        Die Abrechnung erfolgt nach der Gebührenordnung für Heilpraktiker (GebüH). Du erhältst
        nach jeder Behandlung eine Rechnung, die du je nach Versicherung einreichen kannst.
      </p>

      <h3>Wer kann sich behandeln lassen?</h3>
      <p>
        Ich behandle <strong>Privatpatient:innen und Selbstzahlende</strong>. Privatversicherte
        und Zusatzversicherte klären die Erstattung am besten vorab mit ihrer Versicherung.
      </p>

      <h3>Gesetzlich versichert?</h3>
      <p>
        Einige gesetzliche Krankenkassen bezuschussen osteopathische Behandlungen anteilig. Ob und
        in welcher Höhe deine Krankenkasse sich beteiligt, ist unterschiedlich geregelt.
        <strong>
          Bitte informiere dich vorab direkt bei deiner Krankenkasse über Voraussetzungen und
          Erstattungshöhe.
        </strong>
        Häufig wird zum Beispiel eine ärztliche Empfehlung vorausgesetzt.
      </p>
    </div>
  </section>
</Base>

<style>
  .preis-tabelle {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1rem 1.5rem;
    background: var(--bg);
    border-radius: 8px;
    overflow: hidden;
  }

  .preis-tabelle th,
  .preis-tabelle td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(28, 27, 26, 0.1);
  }

  .preis-tabelle th {
    font-family: var(--font-head);
    font-size: 1.05rem;
  }
</style>
