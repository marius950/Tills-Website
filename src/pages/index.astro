---
import Base from '../layouts/Base.astro';
import CtaBlock from '../components/CtaBlock.astro';
import StandortKarten from '../components/StandortKarten.astro';
import Ph from '../components/Ph.astro';
import { praxis, hamburg, moelln } from '../config';

const beschwerden = [
  {
    titel: 'Rücken- und Nackenschmerzen',
    text: 'Ob akut oder immer wiederkehrend.',
  },
  {
    titel: 'Verspannungen & Bewegungseinschränkungen',
    text: 'Wenn der Körper nicht mehr mitmacht wie gewohnt.',
  },
  {
    titel: 'Kopfschmerzen & Kieferbeschwerden',
    text: 'Oft mit Verspannungen im Nacken- und Kieferbereich verbunden.',
  },
  {
    titel: 'Stressbedingte Beschwerden',
    text: 'Wenn Anspannung sich körperlich bemerkbar macht.',
  },
  {
    titel: 'Beschwerden nach Sport & Belastung',
    text: 'Von der Regeneration bis zur Rückkehr ins Training.',
  },
  {
    titel: 'Funktionelle Beschwerden',
    text: 'Beschwerden ohne eindeutigen strukturellen Befund, die den Alltag trotzdem spürbar einschränken.',
  },
];

const prinzipien = [
  {
    titel: 'Evidenzbewusst.',
    text: 'Ich arbeite auf Grundlage meiner Ausbildung als Physiotherapeut, Heilpraktiker und Osteopath und orientiere mich an dem, was wissenschaftlich gut begründbar ist. Was ich nicht seriös einordnen kann, verspreche ich auch nicht.',
  },
  {
    titel: 'Individuell.',
    text: 'Jede Beschwerde hat ihre eigene Geschichte. Deshalb stehen am Anfang jeder Behandlung ein ausführliches Gespräch, eine gründliche Untersuchung und eine verständliche Einordnung deiner Beschwerden.',
  },
  {
    titel: 'Verständlich.',
    text: 'Du sollst nicht nur behandelt werden, sondern verstehen, was in deinem Körper passiert. Ich erkläre dir meine Einschätzung in klarer Sprache und zeige dir, was du selbst tun kannst, um deine Beschwerden zu verbessern.',
  },
  {
    titel: 'Verantwortungsvoll.',
    text: 'Wenn ich der Meinung bin, dass du bei einer Ärztin, einem Arzt oder in einer anderen Behandlungsform besser aufgehoben bist, sage ich dir das offen.',
  },
];

const ablauf = [
  {
    titel: 'Gespräch (Anamnese).',
    text: 'Wir nehmen uns Zeit für deine Geschichte: Beschwerden, Vorerkrankungen, Alltag, Belastungen. Vorhandene Befunde und Arztberichte sind dabei sehr hilfreich.',
  },
  {
    titel: 'Untersuchung.',
    text: 'Ich untersuche dich gründlich, mit Blick auf Beweglichkeit, Spannungsverhältnisse und mögliche Zusammenhänge zwischen verschiedenen Körperregionen.',
  },
  {
    titel: 'Einordnung.',
    text: 'Ich erkläre dir verständlich, was mir auffällt, wie ich deine Beschwerden einordne und ob Osteopathie dich aus meiner Sicht unterstützen kann. Falls eine ärztliche Abklärung sinnvoll ist, bespreche ich das offen mit dir.',
  },
  {
    titel: 'Behandlung.',
    text: 'Die osteopathische Behandlung erfolgt mit den Händen: mit gezielten, in der Regel sanften Techniken, abgestimmt auf dein Beschwerdebild.',
  },
  {
    titel: 'Ausblick.',
    text: 'Zum Abschluss besprechen wir, wie es weitergeht: ob und wann Folgetermine sinnvoll sind und was du selbst tun kannst.',
  },
];
---

<Base
  title="Osteopathie in Hamburg & Mölln | Praxis Till Schneider"
  description="Evidenzbewusste Osteopathie bei Schmerzen, Stress & funktionellen Beschwerden in Hamburg und Mölln. Physiotherapeut, Heilpraktiker & Osteopath. Jetzt Termin buchen."
>
  <!-- Hero: großes Statement + vollbreites Bild (Referenz: osteopathiewerkstatt.de) -->
  <section class="section hero">
    <div class="wrap">
      <p class="eyebrow">Osteopathie in Hamburg &amp; Mölln</p>
      <h1 class="hero-title">Osteopathie, die Zusammenhänge versteht.</h1>
      <p class="hero-sub">
        Evidenzbewusste osteopathische Behandlung bei Schmerzen, Stress und funktionellen
        Beschwerden. Individuell, verständlich und auf Augenhöhe.
      </p>
      <div class="hero-buttons">
        <a href="#termin" class="btn btn--primary">Termin buchen</a>
        <a href="/was-ist-osteopathie/" class="btn btn--secondary">Mehr über Osteopathie erfahren</a>
      </div>
      <ul class="badges">
        <li>Staatl. gepr. Physiotherapeut</li>
        <li>Heilpraktiker</li>
        <li>Osteopath (BAO-geprüft, 1350+ UE)</li>
        <li>5 Jahre NLZ FC St. Pauli</li>
      </ul>
      <figure class="photo-wrap hero-photo">
        <img
          src="/images/hamburg-praxis-1.jpg"
          alt="Behandlungsraum der Osteopathie-Praxis in Hamburg"
          loading="eager"
        />
      </figure>
      <p class="hero-intro">
        Schmerzen haben selten nur eine Ursache. Als Osteopath und Physiotherapeut schaue ich
        genau hin: Wo kommen deine Beschwerden her, was hängt womit zusammen und was können wir
        gemeinsam dagegen tun? Ohne leere Versprechen, dafür mit Erfahrung, Sorgfalt und einem
        Behandlungsansatz, der sich an aktuellem Wissen orientiert.
      </p>
    </div>
  </section>

  <!-- Standortauswahl / Terminbuchung -->
  <section class="section section--beige" id="termin">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Zwei Standorte</span>
        <h2>Hamburg &amp; Mölln</h2>
        <p class="content">
          Ich behandle an zwei Standorten. Termine für Hamburg buchst du online über Doctolib,
          Termine für Mölln vereinbarst du telefonisch.
        </p>
      </div>
      <StandortKarten variante="buchung" />
    </div>
  </section>

  <!-- Wobei Osteopathie unterstützen kann -->
  <section class="section section--beige">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Beschwerdebilder</span>
        <h2>Wobei Osteopathie unterstützen kann</h2>
        <p class="content">
          Osteopathie kann je nach Beschwerdebild eine sinnvolle Ergänzung zu anderen
          Behandlungsformen sein. Häufige Gründe, warum Patient:innen zu mir kommen:
        </p>
      </div>

      <div class="grid grid--3">
        {beschwerden.map((b) => (
          <div class="card">
            <h3>{b.titel}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>

      <div class="notice content-center mt-2">
        <p>
          <strong>Wichtig:</strong> Osteopathie ersetzt keine ärztliche Diagnostik. Bei unklaren,
          akuten oder ernsthaften Beschwerden ist eine ärztliche Abklärung der richtige erste
          Schritt. Und wenn nötig, sage ich dir das auch genau so.
        </p>
      </div>

      <CtaBlock />
    </div>
  </section>

  <!-- So arbeite ich -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Arbeitsweise</span>
        <h2>So arbeite ich</h2>
      </div>
      <div class="grid grid--2">
        {prinzipien.map((p) => (
          <div>
            <h3>{p.titel}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Für wen geeignet -->
  <section class="section section--beige">
    <div class="wrap content-center">
      <span class="eyebrow">Zielgruppen</span>
      <h2>Für wen ist die Behandlung geeignet?</h2>
      <p class="mt-2">Osteopathie kann Menschen in ganz unterschiedlichen Lebenssituationen unterstützen:</p>
      <ul>
        <li><strong>Berufstätige</strong>, die durch langes Sitzen, einseitige Belastung oder Stress körperliche Beschwerden entwickelt haben</li>
        <li><strong>Sportlich Aktive</strong>, die Belastungsbeschwerden angehen, ihre Regeneration verbessern oder nach einer Verletzung zurück ins Training finden möchten</li>
        <li><strong>Menschen mit wiederkehrenden Beschwerden</strong>, bei denen bisherige Behandlungen nur kurzfristig geholfen haben</li>
        <li><strong>Alle, die ihren Körper besser verstehen möchten</strong> und eine Behandlung suchen, die erklärt statt nur anwendet</li>
      </ul>
      <p>
        Ich behandle Privatpatient:innen und Selbstzahlende. Einige gesetzliche Krankenkassen
        bezuschussen osteopathische Behandlungen anteilig. Näheres dazu erfährst du direkt bei
        deiner Krankenkasse.
      </p>
    </div>
  </section>

  <!-- Ablauf der ersten Behandlung -->
  <section class="section">
    <div class="wrap content-center">
      <span class="eyebrow">Dein erster Termin</span>
      <h2>Ablauf der ersten Behandlung</h2>
      <ol class="steps mt-2">
        {ablauf.map((s) => (
          <li>
            <strong>{s.titel}</strong>
            {s.text}
          </li>
        ))}
      </ol>
      <p class="mt-2">Eine osteopathische Behandlung dauert {praxis.dauer}.</p>
      <CtaBlock />
    </div>
  </section>

  <!-- Über mich Teaser -->
  <section class="section section--beige">
    <div class="wrap hero-grid">
      <figure class="photo-wrap teaser-photo">
        <img src="/images/till-portrait.jpg" alt="Till Schneider, Osteopath in Hamburg und Mölln" loading="lazy" />
      </figure>
      <div>
        <span class="eyebrow">Über mich</span>
        <h2>Till Schneider: Osteopath, Physiotherapeut und Heilpraktiker</h2>
        <p class="mt-2">
          Als Physiotherapeut habe ich unter anderem in den Nachwuchsleistungszentren der Hamburg
          Towers und des FC St. Pauli gearbeitet und dabei gelernt, wie viel möglich ist, wenn man
          Körper ernst nimmt und genau hinschaut. Die Osteopathie erweitert diesen Blick: weg vom
          einzelnen Symptom, hin zu den Zusammenhängen. Genau so arbeite ich heute in meiner Praxis.
        </p>
        <a href="/ueber-mich/" class="btn btn--secondary">Mehr über mich erfahren</a>
      </div>
    </div>
  </section>

  <!-- Preis-Teaser -->
  <section class="section">
    <div class="wrap content-center center">
      <span class="eyebrow">Kosten &amp; Erstattung</span>
      <h2>Transparent von Anfang an</h2>
      <p class="mt-2">
        Eine osteopathische Behandlung kostet <strong>{praxis.preis}</strong> und dauert
        {praxis.dauer}. Ich behandle Privatpatient:innen und Selbstzahlende. Einige gesetzliche
        Krankenkassen bezuschussen osteopathische Behandlungen anteilig. Bitte informiere dich
        vorab direkt bei deiner Krankenkasse über Voraussetzungen und Erstattungshöhe.
      </p>
      <a href="/terminbuchung/" class="btn btn--secondary">Alle Infos zu Preisen und Ablauf</a>
    </div>
  </section>

  <!-- FAQ-Teaser -->
  <section class="section section--beige">
    <div class="wrap content-center">
      <span class="eyebrow">Gut zu wissen</span>
      <h2>Häufige Fragen</h2>
      <div class="mt-2">
        <details class="faq-item">
          <summary>Brauche ich eine ärztliche Überweisung?</summary>
          <div class="faq-body">
            <p>
              Nein. Als Heilpraktiker darf ich dich auch ohne Verordnung behandeln. Bei unklaren
              Beschwerden empfehle ich dennoch eine ärztliche Abklärung vorab.
            </p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Wie viele Behandlungen brauche ich?</summary>
          <div class="faq-body">
            <p>
              Das hängt vom Beschwerdebild ab. Nach dem ersten Termin gebe ich dir eine ehrliche
              Einschätzung.
            </p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Ist die Behandlung schmerzhaft?</summary>
          <div class="faq-body">
            <p>
              Osteopathische Techniken sind in der Regel sanft. Ich arbeite immer in Abstimmung mit
              dir.
            </p>
          </div>
        </details>
      </div>
      <p class="mt-2"><a href="/faq/">Alle Fragen &amp; Antworten →</a></p>
    </div>
  </section>

  <!-- Abschluss-CTA (dunkler Block) -->
  <section class="section section--dark">
    <div class="wrap content-center center">
      <h2>Bereit für deinen ersten Termin?</h2>
      <p class="mt-2">
        Termine für Hamburg buchst du online über Doctolib. Termine für Mölln vereinbarst du
        telefonisch unter <a href={moelln.telefonLink} class="cta-tel">{moelln.telefon}</a>.
      </p>
      <a href="#termin" class="btn btn--primary">Termin buchen</a>
      <p class="small mt-2">
        {praxis.name}<br />
        Hamburg: {hamburg.adresse.join(', ')}<br />
        Mölln: {moelln.adresse.join(', ')}<br />
        E-Mail: <Ph value={praxis.email} />
      </p>
    </div>
  </section>
</Base>

<style>
  .hero-title {
    font-size: clamp(2.4rem, 6.5vw, 4.3rem);
    max-width: 1000px;
  }

  .hero-sub {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 500;
    max-width: 720px;
    margin-block: 1.5rem 1.75rem;
    text-wrap: pretty;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-photo {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .hero-photo img {
    aspect-ratio: 16 / 9;
    max-height: 620px;
    object-position: center 40%;
  }

  @media (max-width: 640px) {
    .hero-photo img { aspect-ratio: 4 / 3; }
  }

  .hero-intro {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    max-width: 720px;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* Über-mich-Teaser: zweispaltiges Layout */
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1fr 1.15fr; }
  }

  .teaser-photo img {
    max-height: 460px;
  }

  .cta-tel {
    font-weight: 700;
  }
</style>
