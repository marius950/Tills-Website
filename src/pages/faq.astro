---
import Base from '../layouts/Base.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Ph from '../components/Ph.astro';
import { praxis } from '../config';

const gruppen = [
  {
    titel: 'Erster Termin',
    fragen: [
      {
        f: 'Was passiert beim ersten Termin?',
        a: `Der erste Termin beginnt mit einem ausführlichen Gespräch über deine Beschwerden, deine Krankengeschichte und deinen Alltag. Danach untersuche ich dich gründlich, mit Blick auf Beweglichkeit, Spannungsverhältnisse und mögliche Zusammenhänge. Anschließend erkläre ich dir meine Einschätzung verständlich, und wir besprechen gemeinsam das weitere Vorgehen. In der Regel beginnt die Behandlung bereits im ersten Termin. Eine osteopathische Behandlung dauert ${praxis.dauer}.`,
      },
      {
        f: 'Brauche ich eine ärztliche Verordnung?',
        a: 'Nein. Als staatlich geprüfter Heilpraktiker darf ich dich auch ohne ärztliche Verordnung untersuchen und behandeln. Bei unklaren, akuten oder ernsthaften Beschwerden empfehle ich dennoch, diese zunächst ärztlich abklären zu lassen. Hinweis: Wenn deine gesetzliche Krankenkasse osteopathische Behandlungen bezuschusst, verlangt sie dafür häufig eine ärztliche Empfehlung. Frag im Zweifel vorab bei deiner Kasse nach.',
      },
      {
        f: 'Was sollte ich zum Termin mitbringen?',
        a: 'Vorhandene Befunde und Arztberichte (z. B. Röntgen- oder MRT-Befunde), eine aktuelle Medikamentenliste, ein großes Handtuch und bequeme Kleidung. Alle Details findest du auf der Seite Terminbuchung.',
      },
    ],
  },
  {
    titel: 'Kosten & Organisation',
    fragen: [
      {
        f: 'Was kostet eine Behandlung?',
        a: `Eine osteopathische Behandlung kostet ${praxis.preis}. Sie dauert ${praxis.dauer}. Du erhältst nach jeder Behandlung eine Rechnung nach der Gebührenordnung für Heilpraktiker (GebüH), die du je nach Versicherung zur Erstattung einreichen kannst.`,
      },
      {
        f: 'Übernimmt meine Krankenkasse die Kosten?',
        a: 'Das hängt von deiner Versicherung ab. Private Krankenversicherungen und viele Zusatzversicherungen erstatten osteopathische Behandlungen ganz oder teilweise. Ein Blick in deinen Tarif oder eine kurze Nachfrage lohnt sich. Einige gesetzliche Krankenkassen bezuschussen Osteopathie anteilig; Voraussetzungen und Erstattungshöhe sind unterschiedlich. Bitte informiere dich vorab direkt bei deiner Krankenkasse.',
      },
      {
        f: 'Behandelst du auch gesetzlich Versicherte?',
        a: 'Ja, als Selbstzahlende. Die Behandlung läuft dann auf eigene Rechnung. Einige gesetzliche Krankenkassen beteiligen sich anteilig an den Kosten; bitte kläre Voraussetzungen und Erstattungshöhe vorab direkt mit deiner Kasse.',
      },
    ],
  },
  {
    titel: 'Behandlung',
    fragen: [
      {
        f: 'Wie viele Behandlungen sind notwendig?',
        a: 'Das lässt sich seriös nicht pauschal beantworten: Es hängt von deinem Beschwerdebild, dessen Dauer und deiner individuellen Situation ab. Häufig zeigt sich schon nach wenigen Terminen, ob und wie gut die Behandlung anschlägt. Nach dem ersten Termin gebe ich dir eine ehrliche Einschätzung. Mein Anspruch ist, so viele Termine wie nötig und so wenige wie möglich.',
      },
      {
        f: 'Ist Osteopathie schmerzhaft?',
        a: 'Osteopathische Techniken sind in der Regel sanft. Manche Handgriffe können an verspannten oder empfindlichen Stellen kurzzeitig unangenehm sein. Ich arbeite aber immer in Abstimmung mit dir und passe die Behandlung an. Nach einer Behandlung kann der Körper vorübergehend reagieren, etwa mit einem Gefühl wie Muskelkater. Das klingt üblicherweise nach kurzer Zeit wieder ab.',
      },
      {
        f: 'Für welche Beschwerden kann Osteopathie geeignet sein?',
        a: 'Je nach Beschwerdebild kann Osteopathie unterstützend eingesetzt werden, zum Beispiel bei Rücken-, Nacken- und Schulterschmerzen, Verspannungen, Bewegungseinschränkungen, spannungsbedingten Kopfschmerzen, Kieferbeschwerden, stressbedingten körperlichen Beschwerden, funktionellen Beschwerden, Verdauungsbeschwerden und zyklusbedingten Beschwerden. Ob Osteopathie in deinem Fall sinnvoll sein kann, lässt sich am besten im ersten Termin einschätzen.',
      },
      {
        f: 'Wann sollte ich meine Beschwerden vorher ärztlich abklären lassen?',
        a: 'Immer dann, wenn Beschwerden akut, stark, unklar oder ungewöhnlich sind, insbesondere nach Unfällen, bei rasch zunehmenden Schmerzen oder bei Begleitsymptomen wie Fieber, ungewolltem Gewichtsverlust, Taubheitsgefühlen oder Lähmungserscheinungen. Osteopathie ersetzt keine ärztliche Diagnostik. Im Zweifel gilt: erst ärztlich abklären, dann behandeln. Wenn sich im Termin Hinweise auf einen Abklärungsbedarf ergeben, sage ich dir das offen.',
      },
    ],
  },
  {
    titel: 'Buchung',
    fragen: [
      {
        f: 'Wie buche ich einen Termin?',
        a: 'Termine für Hamburg buchst du online über Doctolib: Klick auf „Termin buchen", wähl den Standort Hamburg, such dir eine freie Zeit aus und bestätige die Buchung. Bei der ersten Buchung legst du ein kostenloses Doctolib-Konto an; du erhältst automatisch eine Bestätigung per E-Mail und eine Erinnerung vor dem Termin. Termine für Mölln können telefonisch vereinbart werden unter +49 4542 835328.',
      },
      {
        f: 'Wie kann ich einen Termin absagen oder verschieben?',
        a: 'Termine für Hamburg sagst du am einfachsten direkt über Doctolib ab (in deiner Terminbestätigung oder deinem Konto), Termine für Mölln telefonisch. Bitte spätestens 24 Stunden vorher, damit ich den Termin anderweitig vergeben kann. Bei kurzfristigen Absagen kann ein Ausfallhonorar anfallen.',
      },
    ],
  },
];

// FAQ-Schema für Google-Rich-Snippets (FAQPage, schema.org)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: gruppen.flatMap((g) =>
    g.fragen.map((frage) => ({
      '@type': 'Question',
      name: frage.f,
      acceptedAnswer: { '@type': 'Answer', text: frage.a },
    }))
  ),
};
---

<Base
  title="FAQ Osteopathie: Kosten, Ablauf & Krankenkasse | Praxis Till Schneider"
  description="Antworten auf häufige Fragen: Was kostet Osteopathie? Zahlt die Krankenkasse? Was passiert beim ersten Termin? Ehrlich und verständlich beantwortet."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="section">
    <div class="wrap content-center">
      <span class="eyebrow">FAQ</span>
      <h1>Häufige Fragen</h1>

      {gruppen.map((g) => (
        <div class="faq-gruppe">
          <h2>{g.titel}</h2>
          {g.fragen.map((frage) => (
            <details class="faq-item">
              <summary>{frage.f}</summary>
              <div class="faq-body">
                <p>{frage.a}</p>
              </div>
            </details>
          ))}
        </div>
      ))}

      <div class="notice mt-2">
        <p>
          <strong>Deine Frage war nicht dabei?</strong> Schreib mir an
          <Ph value={praxis.email} />. Ich antworte so schnell wie möglich.
        </p>
      </div>

      <CtaBlock button="Termin über Doctolib buchen" />
    </div>
  </section>
</Base>

<style>
  .faq-gruppe {
    margin-top: 2.5rem;
  }

  .faq-gruppe h2 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }
</style>
