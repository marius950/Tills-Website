---
// Google-Ads-Landingpage „Osteopathie Hamburg": ein Ziel (Doctolib-Buchung), Anruf als Alternative.
// noindex und ohne Navigation (Base schlank). Texte ohne Heilversprechen (HWG § 3): Beschwerden
// stehen als „kann unterstützen", Bewertungen ohne Erfolgsaussagen, keine Rabatte (HWG § 7).
import Base from '../../layouts/Base.astro';
import Behandlungszeiten from '../../components/Behandlungszeiten.astro';
import GoogleBewertungen from '../../components/GoogleBewertungen.astro';
import { praxis, hamburg, mapsLink, zeitenSatz } from '../../config';

const vertrauen = [
  {
    titel: 'Dreifach qualifiziert',
    text: 'Staatlich geprüfter Physiotherapeut, Heilpraktiker und Osteopath (BAO-geprüft, Bachelor of Science Osteopathie).',
  },
  {
    titel: 'Erfahrung aus dem Leistungssport',
    text: 'Physiotherapeut in den Nachwuchsleistungszentren des FC St. Pauli und der Hamburg Towers, bevor ich mich auf Osteopathie konzentriert habe.',
  },
  {
    titel: 'Ehrlich beraten',
    text: 'Ich verspreche nichts, was ich nicht seriös einordnen kann. Wenn eine ärztliche Abklärung der bessere Weg ist, sage ich das offen.',
  },
];

const beschwerden = [
  { titel: 'Rücken- und Nackenschmerzen', text: 'akut oder immer wiederkehrend, oft nach langem Sitzen' },
  { titel: 'Verspannungen und eingeschränkte Beweglichkeit', text: 'wenn der Körper nicht mehr mitmacht wie gewohnt' },
  { titel: 'Kopfschmerzen und Kieferbeschwerden (CMD)', text: 'häufig verbunden mit Verspannungen in Nacken und Kiefer' },
  { titel: 'Stressbedingte Beschwerden', text: 'wenn sich Anspannung körperlich bemerkbar macht' },
  { titel: 'Beschwerden nach Sport und Belastung', text: 'von der Regeneration bis zur Rückkehr ins Training' },
  { titel: 'Funktionelle Beschwerden ohne klaren Befund', text: 'die den Alltag trotzdem spürbar einschränken' },
];

const ablauf = [
  { titel: 'Gespräch', text: 'Du schilderst deine Beschwerden und deinen Alltag. Vorhandene Befunde und Arztberichte sind hilfreich.' },
  { titel: 'Untersuchung', text: 'Ich untersuche gründlich: Beweglichkeit, Spannungsverhältnisse und Zusammenhänge zwischen Körperregionen.' },
  { titel: 'Einordnung', text: 'Ich erkläre dir verständlich, was mir auffällt, und sage offen, wenn eine ärztliche Abklärung sinnvoll ist.' },
  { titel: 'Behandlung', text: 'Mit den Händen, in der Regel sanft und auf dein Beschwerdebild abgestimmt. Zum Schluss besprechen wir, wie es weitergeht.' },
];

const fragen = [
  {
    f: 'Brauche ich eine Überweisung?',
    a: 'Nein. Du kannst direkt einen Termin buchen. Vorhandene Befunde oder Arztberichte sind hilfreich, aber keine Voraussetzung.',
  },
  {
    f: 'Was kostet eine Behandlung, und zahlt die Krankenkasse?',
    a: `Eine Behandlung dauert ${praxis.dauer} und kostet ${praxis.preis}. Du bekommst eine Rechnung nach der Gebührenordnung für Heilpraktiker. Viele gesetzliche Kassen bezuschussen Osteopathie anteilig, private und Zusatzversicherungen erstatten je nach Tarif. Frag am besten vorab bei deiner Kasse nach.`,
  },
  {
    f: 'Wann sind Termine möglich?',
    a: `In Hamburg behandle ich ${zeitenSatz(hamburg.zeiten)}. Alle freien Termine siehst du in Echtzeit bei Doctolib.`,
  },
  {
    f: 'Wie schnell bekomme ich einen Termin?',
    a: 'Das hängt von der aktuellen Auslastung ab. Bei Doctolib siehst du sofort, welche Termine frei sind, ohne Anruf und ohne Warteschleife.',
  },
  {
    f: 'Was soll ich mitbringen?',
    a: 'Befunde und Arztberichte, falls vorhanden, eine aktuelle Medikamentenliste, ein großes Handtuch und bequeme Kleidung.',
  },
];
---

<Base
  title="Osteopathie in Hamburg – Termin online buchen | Till Schneider"
  description={`Osteopathie in Hamburg-Rotherbaum: ${praxis.dauer} für ${praxis.preis}, dienstags und mittwochs, Termin online über Doctolib. Osteopath, Physiotherapeut und Heilpraktiker Till Schneider.`}
  noindex
  schlank
>
  <section class="section lp-hero">
    <div class="wrap lp-hero-grid">
      <div>
        <p class="eyebrow">Osteopathie in Hamburg-Rotherbaum · Praxis Till Schneider</p>
        <h1>Osteopathie in Hamburg: gründlich untersucht, verständlich erklärt.</h1>
        <p class="lead">
          Als Osteopath, Physiotherapeut und Heilpraktiker nehme ich mir in meiner Praxis am Grindel
          {praxis.dauer} Zeit für dich: für ein ausführliches Gespräch, eine gründliche Untersuchung
          und eine Behandlung, die zu deinen Beschwerden passt. Ob Rücken und Nacken, Verspannungen,
          Kopf- und Kieferbeschwerden oder Belastung nach dem Sport.
        </p>
        <ul class="lp-fakten">
          <li>{praxis.dauer} Behandlung für {praxis.preis}, Rechnung nach GebüH</li>
          <li>Termine dienstags und mittwochs, online buchbar rund um die Uhr</li>
          <li>Rotherbaum am Grindel, eigene Parkplätze für Patient:innen</li>
        </ul>
        <div class="lp-cta">
          <a href={praxis.doctolib} target="_blank" rel="noopener" class="btn btn--primary">
            Termin bei Doctolib buchen
          </a>
          <a href={hamburg.telefonLink} class="btn btn--secondary">Anrufen: {hamburg.telefon}</a>
        </div>
        <p class="lp-proof"><GoogleBewertungen variante="badge" /></p>
      </div>
      <figure class="lp-portrait">
        <img
          src="/images/till-portrait.webp"
          alt="Till Schneider, Osteopath in Hamburg"
          width="623"
          height="831"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <section class="section section--beige">
    <div class="wrap">
      <div class="grid grid--3">
        {vertrauen.map((punkt) => (
          <div class="card">
            <h2 class="lp-card-titel">{punkt.titel}</h2>
            <p>{punkt.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Beschwerden</span>
        <h2>Wobei Osteopathie unterstützen kann</h2>
        <p class="content">
          Osteopathie ersetzt keine ärztliche Diagnose. Bei starken, neuen oder unklaren Beschwerden
          kläre bitte zuerst ärztlich ab.
        </p>
      </div>
      <div class="grid grid--3">
        {beschwerden.map((b) => (
          <div class="card">
            <h3>{b.titel}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--beige">
    <div class="wrap content-center">
      <div class="section-head">
        <span class="eyebrow">Ablauf</span>
        <h2>So läuft dein erster Termin ab</h2>
      </div>
      <ol class="lp-steps">
        {ablauf.map((schritt) => (
          <li>
            <h3>{schritt.titel}</h3>
            <p>{schritt.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <GoogleBewertungen variante="zitate" />
    </div>
  </section>

  <section class="section section--beige">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Praxis</span>
        <h2>Praxis in Hamburg-Rotherbaum</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <h3>Adresse</h3>
          <p>
            {hamburg.adresse[0]}<br />
            {hamburg.adresse[1]}<br />
            {hamburg.adresse[2]}
          </p>
          <p>
            <a href={mapsLink(hamburg)} target="_blank" rel="noopener">Route planen</a>
          </p>
        </div>
        <div class="card">
          <h3>Behandlungszeiten</h3>
          <p><Behandlungszeiten zeiten={hamburg.zeiten} /></p>
          <p>Freie Termine siehst du in Echtzeit bei Doctolib.</p>
        </div>
        <div class="card">
          <h3>Anfahrt</h3>
          <p>
            Mit dem Auto: Für die Praxis gibt es eigene Parkplätze. Mit Bus und Bahn: Haltestellen
            Grindelhof und Universität/Staatsbibliothek rund 250 Meter, U-Bahn Schlump oder
            Sternschanze etwa 700 Meter zu Fuß.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap content-center">
      <div class="section-head">
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Gut zu wissen vor dem ersten Termin</h2>
      </div>
      {fragen.map((frage) => (
        <details class="faq-item">
          <summary>{frage.f}</summary>
          <div class="faq-body">
            <p>{frage.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap content-center center">
      <h2>Jetzt Termin in Hamburg buchen</h2>
      <p class="mt-2">
        Du siehst alle freien Termine in Echtzeit und bekommst sofort eine Bestätigung. Lieber
        sprechen? Ruf an oder schreib eine E-Mail an
        <a href={`mailto:${praxis.email}`}>{praxis.email}</a>.
      </p>
      <div class="lp-cta lp-cta--center">
        <a href={praxis.doctolib} target="_blank" rel="noopener" class="btn btn--primary">
          Termin bei Doctolib buchen
        </a>
        <a href={hamburg.telefonLink} class="lp-tel-link">Anrufen: {hamburg.telefon}</a>
      </div>
      <p class="lp-proof mt-2"><GoogleBewertungen variante="badge" /></p>
    </div>
  </section>
</Base>

<style>
  .lp-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .lp-hero-grid { grid-template-columns: 1.15fr 0.85fr; }
  }

  .lp-hero h1 { margin-bottom: 1rem; }

  .lead {
    font-size: 1.15rem;
    color: var(--muted);
  }

  .lp-fakten {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .lp-fakten li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .lp-fakten li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: 700;
  }

  .lp-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .lp-cta--center {
    justify-content: center;
    margin-top: 1.5rem;
  }

  .lp-proof { margin-top: 1rem; }

  .lp-portrait {
    margin: 0;
    max-width: 420px;
    justify-self: center;
  }

  .lp-portrait img {
    width: 100%;
    height: auto;
    border-radius: 14px;
  }

  .lp-card-titel { font-size: 1.2rem; }

  .lp-steps {
    counter-reset: schritt;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lp-steps li {
    counter-increment: schritt;
    position: relative;
    padding-left: 3.25rem;
    margin-bottom: 1.5rem;
  }

  .lp-steps li::before {
    content: counter(schritt);
    position: absolute;
    left: 0;
    top: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .lp-steps h3 { margin-bottom: 0.25rem; }

  .lp-tel-link {
    color: #f5f2ec;
    font-weight: 600;
  }
</style>
