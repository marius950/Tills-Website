---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const artikel = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const datumFormat = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' });
---

<Base
  title="Blog | Wissen zu Osteopathie, Schmerzen & Regeneration – Till Schneider"
  description="Verständliche Artikel über Rückenschmerzen, Stress, Regeneration und Osteopathie – evidenzbewusst geschrieben von Osteopath Till Schneider."
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Blog</span>
      <h1>Wissen zu Osteopathie, Schmerzen &amp; Regeneration</h1>
      <p class="content mt-2">
        Verständliche, evidenzbewusste Artikel – ohne Werbesprache und ohne Heilversprechen.
      </p>

      <div class="grid grid--3 mt-2">
        {artikel.map((a) => (
          <article class="card artikel-card">
            <div class="img-placeholder artikel-bild" role="img" aria-label="Artikelbild-Platzhalter">
              [Artikelbild]
            </div>
            <p class="artikel-meta">
              {a.data.kategorie} · {datumFormat.format(a.data.pubDate)} · {a.data.lesedauer}
              {a.data.entwurf && <span class="ph">Entwurf</span>}
            </p>
            <h2 class="artikel-titel">
              <a href={`/blog/${a.id}/`}>{a.data.title}</a>
            </h2>
            <p>{a.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .artikel-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .artikel-bild {
    min-height: 160px;
    margin-bottom: 0.5rem;
  }

  .artikel-meta {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }

  .artikel-titel {
    font-size: 1.25rem;
    margin: 0;
  }

  .artikel-titel a {
    text-decoration: none;
  }

  .artikel-titel a:hover {
    color: var(--primary);
  }
</style>
