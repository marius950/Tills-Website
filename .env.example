# Google Ads Conversion-Tracking (optional). Ohne PUBLIC_GOOGLE_ADS_ID bleiben Cookie-Banner
# und Google-Tag komplett deaktiviert. Werte in Vercel unter Settings → Environment Variables setzen.
PUBLIC_GOOGLE_ADS_ID=
# Conversion-Labels aus Google Ads (Ziele → Conversion → Tag-Einrichtung). Ohne Label werden die
# Klicks als Events „doctolib_klick" und „anruf_klick" gemeldet.
PUBLIC_ADS_LABEL_DOCTOLIB=
PUBLIC_ADS_LABEL_ANRUF=
